# Copy to .env for local work. The deploy host carries the real values.

ENVIRONMENT=development

# Comma separated. Add the production origin when the widget goes live.
ALLOWED_ORIGINS=http://localhost:3000

# Google AI Studio, not Google Cloud. https://aistudio.google.com/apikey
# Empty is supported: while it is empty /chat answers with the napping
# fallback instead of failing.
LLM_API_KEY=
LLM_MODEL=gemini-3.7-flash

# Neon connection string, pooled endpoint. Carries the checkpointer, the
# interrupt resume state and pgvector.
DATABASE_URL=

# A token is optional. Without one GitHub allows 60 requests an hour across
# every visitor; with one it is 5000. It needs no scopes for public data.
GITHUB_USERNAME=vroslmend
GITHUB_TOKEN=

# portfolio-v2 already proxies Spotify. Point at that rather than issuing a
# second refresh token.
NOW_PLAYING_URL=https://ammarhassan.dev/api/now-playing

SITE_BASE_URL=https://ammarhassan.dev

MAX_TOKENS_PER_REQUEST=2048
RATE_LIMIT_PER_MINUTE=10
