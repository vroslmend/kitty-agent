# Copy to .env for local work. The deploy host carries the real values.

ENVIRONMENT=development

# Comma separated. Add the production origin when the widget goes live.
ALLOWED_ORIGINS=http://localhost:3000

# Empty until the agent exists. While it is empty /chat answers with the
# napping fallback instead of failing.
LLM_API_KEY=

MAX_TOKENS_PER_REQUEST=2048
RATE_LIMIT_PER_MINUTE=10
